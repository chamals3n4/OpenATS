# Configuration for the Docker Compose stack (docker-compose.yml).
#
#   cp .env.example .env
#
# This file is only for the Docker path. Running the app with `pnpm dev`
# instead uses backend/.env and frontend/.env — see CONTRIBUTING.md.
#
# Everything here has a working default except the third-party credentials.
# The stack starts without them; the features that use them will not work.

# ---------------------------------------------------------------------------
# Ports on your machine. Change these if something already uses them.
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Database and Redis
#
# The defaults point at the containers in this stack. Override DATABASE_URL to
# use a hosted Postgres (Neon) instead; the `postgres` service then goes unused.
# ---------------------------------------------------------------------------
POSTGRES_USER=openats
POSTGRES_PASSWORD=openats
POSTGRES_DB=openats
DATABASE_URL=postgresql://openats:openats@postgres:5432/openats
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# URLs
#
# NEXT_PUBLIC_* are compiled into the browser bundle, so they must be reachable
# from your browser. OPENATS_API_URL is used by the Next.js server and resolves
# over the Docker network. Run `docker compose up -d --build` after changing a
# NEXT_PUBLIC_* value — a restart alone will not pick it up.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
OPENATS_API_URL=http://backend:8080
# Allowed browser origin for the API's CORS check.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (Resend) and CV analysis (Gemini)
#
# Both keys are read at module scope, so leaving either empty crash-loops the
# API instead of just disabling the feature. They ship as placeholders to keep
# `docker compose up` working — replace them to actually send mail or analyse
# CVs. GEMINI_API_KEY is what the worker uses.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=onboarding@resend.dev
GEMINI_API_KEY=placeholder

# ---------------------------------------------------------------------------
# Auth — WSO2 Asgardeo. See docs/IAM_SETUP.md.
#
# Most routes sit behind the auth middleware, so the app is not usable
# end-to-end until these are set. ASGARDEO_JWKS_URL must be a valid URL even
# before then: the API parses it at startup and will not boot on an empty
# value, hence the dummy default below.
# ---------------------------------------------------------------------------
ASGARDEO_JWKS_URL=https://api.asgardeo.io/t/example/oauth2/jwks
ASGARDEO_ISSUER=

NEXT_PUBLIC_ASGARDEO_BASE_URL=
NEXT_PUBLIC_ASGARDEO_CLIENT_ID=
ASGARDEO_BASE_URL=
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=
ASGARDEO_SCIM_CLIENT_ID=
ASGARDEO_SCIM_CLIENT_SECRET=
ASGARDEO_MANAGEMENT_SCOPES=
ASGARDEO_SUPER_ADMIN_ROLE_ID=
ASGARDEO_HIRING_MANAGER_ROLE_ID=
ASGARDEO_INTERVIEWER_ROLE_ID=

# ---------------------------------------------------------------------------
# File storage — Cloudflare R2. Needed for CV/resume uploads.
# ---------------------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Google Calendar / Meet — interview scheduling. Optional.
# ---------------------------------------------------------------------------
# base64-encoded 32-byte AES-256 key, for encrypting stored OAuth tokens:
#   openssl rand -base64 32
ENCRYPTION_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# "true" only if the service account has Domain-Wide Delegation, otherwise
# attendee invites fail.
GOOGLE_CALENDAR_ALLOW_ATTENDEES=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
