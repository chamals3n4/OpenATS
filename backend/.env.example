# Copy this file to backend/.env. `make setup` does that for you and fills in ENCRYPTION_KEY.

# Core (required)
DATABASE_URL=postgresql://openats:openats@localhost:5432/openats
REDIS_URL=redis://localhost:6379
# The site candidates open. Every link in a candidate email starts with it, so in production
# set it to your public address, e.g. https://careers.example.com (no slash at the end needed)
FRONTEND_URL=http://localhost:3000
PORT=8080

# How many proxies (Nginx, a load balancer) are in front of this server. The default is 1.
# It lets the server see each visitor's own address, which the rate limits depend on.
# Set it to false when the server is reached directly, with no proxy in front.
# TRUST_PROXY=1

# Sign-in (required)
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000

# Encrypts saved integration tokens. Must be 32 bytes, base64 encoded; the server will not start
# with anything else. Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# File storage (required). Two buckets on the same account:
# R2_BUCKET_NAME is public and holds logos; R2_PUBLIC_URL is its public address.
# R2_PRIVATE_BUCKET_NAME holds CVs. Do not give it public access or a custom domain:
# CVs are only ever sent by this server, to signed-in users.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET_NAME=

# Email (required): any SMTP server. These defaults send to Mailpit from docker-compose.yml,
# whose inbox is at http://localhost:8025. Examples for real providers:
#   Resend     SMTP_HOST=smtp.resend.com  SMTP_PORT=465 SMTP_SECURE=true  SMTP_USER=resend  SMTP_PASSWORD=<API key>
#   Gmail      SMTP_HOST=smtp.gmail.com   SMTP_PORT=465 SMTP_SECURE=true  SMTP_USER=<address> SMTP_PASSWORD=<app password>
#   Office 365 SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false SMTP_USER=<address> SMTP_PASSWORD=<password>
#   Amazon SES SMTP_HOST=email-smtp.<region>.amazonaws.com SMTP_PORT=587 SMTP_SECURE=false (SES SMTP credentials)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=hiring@example.com
MAIL_FROM_NAME=OpenATS

# Background worker (optional)
# Set to true to run the CV and queue workers inside this process, when hosting has no separate
# worker service (`pnpm start:worker`). Do not set it if you run the worker as its own process.
# RUN_WORKER_IN_API=true

# AI CV analysis (optional) 

# Google Gemini key. Leave empty to run without it; it also stays off until turned on in Settings.
GEMINI_API_KEY=

# Google Calendar and Meet (optional)

# OAuth app that lets each interviewer connect their own Google account, so their interviews
# go in their calendar and can get a Meet link. The redirect URI is this API's address
# followed by /oauth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Rate limits (optional)
# Requests per signed-in user per 15 minutes: general routes, then uploads.
RATE_LIMIT_API=1000
RATE_LIMIT_EXPENSIVE=60
