# Copy this file to backend/.env. `make setup` does that for you and fills in ENCRYPTION_KEY.

# Core (required)
DATABASE_URL=postgresql://openats:openats@localhost:5432/openats
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
PORT=8080

# Sign-in (required)
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000

# Encrypts saved integration tokens. A base64 32-byte key: openssl rand -base64 32
ENCRYPTION_KEY=

# File storage (required)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email (required)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI CV analysis (optional) 

# Google Gemini key. Leave empty to run without it; it also stays off until turned on in Settings.
GEMINI_API_KEY=

# Google Calendar (optional)

# Service account that creates interview events on a shared calendar.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
# Set to "true" only if the service account has Domain-Wide Delegation; otherwise invites fail.
GOOGLE_CALENDAR_ALLOW_ATTENDEES=

# OAuth app that lets each interviewer connect their own Google account for Meet links.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Rate limits (optional)
# Requests per signed-in user per 15 minutes: general routes, then uploads.
RATE_LIMIT_API=1000
RATE_LIMIT_EXPENSIVE=60
