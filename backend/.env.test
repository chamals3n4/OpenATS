DATABASE_URL=postgresql://openats:openats@localhost:5433/openats_test
REDIS_URL=redis://localhost:6379

# Dummy values. No test verifies a real token; these exist only so that
# auth.middleware.ts can build its JWKS client at import time without a real
# Asgardeo tenant. Kept in the repo (not in CI secrets) so that tests pass on
# pull requests from forks, which GitHub never gives secrets to.
ASGARDEO_JWKS_URL=http://localhost/jwks
ASGARDEO_ISSUER=http://localhost
RESEND_API_KEY=re_test_000000000000000000000000
GEMINI_API_KEY=test-gemini-key
