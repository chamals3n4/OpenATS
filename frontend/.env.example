# Frontend configuration for the `pnpm dev` workflow.
#
#   cp .env.example .env
#
# Running the stack with Docker instead? Use the root .env.example — this file
# is not read by docker-compose.yml. See docs/DOCKER.md.

# ---------------------------------------------------------------------------
# API
#
# NEXT_PUBLIC_API_URL is compiled into the browser bundle, so it must be
# reachable from the browser. OPENATS_API_URL is used by server components and
# route handlers, and may be an internal address the browser cannot see.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
OPENATS_API_URL=http://localhost:8080

# Public origin of this frontend. Used to build the shareable careers page URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# WSO2 Asgardeo
#
# Required — the root layout renders through AsgardeoProvider, so pages fail
# to render until at least the base URL and client ID are set.
# docs/IAM_SETUP.md walks through creating these.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ASGARDEO_BASE_URL=
NEXT_PUBLIC_ASGARDEO_CLIENT_ID=
ASGARDEO_BASE_URL=
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=

# Management application credentials, used for SCIM user/role calls.
ASGARDEO_SCIM_CLIENT_ID=
ASGARDEO_SCIM_CLIENT_SECRET=
ASGARDEO_MANAGEMENT_SCOPES=

# Role IDs from your Asgardeo organization.
ASGARDEO_SUPER_ADMIN_ROLE_ID=
ASGARDEO_HIRING_MANAGER_ROLE_ID=
ASGARDEO_INTERVIEWER_ROLE_ID=
