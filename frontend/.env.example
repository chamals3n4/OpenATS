NEXT_PUBLIC_ASGARDEO_BASE_URL=""
NEXT_PUBLIC_ASGARDEO_CLIENT_ID=""
ASGARDEO_CLIENT_SECRET=""
NEXT_PUBLIC_ASGARDEO_SCOPES="openid profile email offline_access internal_user_mgt_create internal_user_mgt_delete internal_user_mgt_list internal_user_mgt_update internal_user_mgt_view internal_user_credential_mgt_create internal_user_credential_mgt_delete internal_user_credential_mgt_view internal_role_mgt_create internal_role_mgt_delete internal_role_mgt_groups_update internal_role_mgt_meta_create internal_role_mgt_meta_update internal_role_mgt_update internal_role_mgt_users_update internal_role_mgt_view"
ASGARDEO_SECRET=""
ASGARDEO_CLIENT_ID=""
NEXT_PUBLIC_ASGARDEO_SIGN_IN_URL=""

ASGARDEO_SUPER_ADMIN_ROLE_ID=""
ASGARDEO_HIRING_MANAGER_ROLE_ID=""
ASGARDEO_INTERVIEWER_ROLE_ID=""

OPENATS_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=""

# Better Auth (server-only: never prefix these with NEXT_PUBLIC_)
# Same database as backend/.env; the auth tables come from the backend migrations.
DATABASE_URL=postgresql://openats:openats@localhost:5432/openats
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=http://localhost:3000

# Invite and password reset emails, sent from the Next.js server (server-only).
# Use the same values as backend/.env. Optional: without them the app still
# runs, the link is printed to the server console in development, and the
# "invite" option in the create-user dialog is disabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public demo only. Leave unset on a self-hosted install: the sign-in page then
# shows no credentials. These are sent to the browser, so never put a real
# account's password here.
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
