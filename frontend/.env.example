# Copy this file to frontend/.env. `make setup` does that for you and fills in the sign-in values.

OPENATS_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
# Optional. The public URL of this app, shown in the careers page links. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Sign-in (required, server-only: never prefix these with NEXT_PUBLIC_)

# The same database as backend/.env. The sign-in tables come from the backend migrations.
DATABASE_URL=postgresql://openats:openats@localhost:5432/openats
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The public URL of this app. Must be exactly the same as AUTH_ISSUER in backend/.env.
BETTER_AUTH_URL=http://localhost:3000
# Optional. Proxy IPs or CIDR ranges in front of the app (comma-separated), for per-client sign-in limits.
AUTH_TRUSTED_PROXIES=

# Sends invite and password reset emails (same values as backend/.env). Without them, no email is sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shows demo sign-in details on the sign-in page. Leave empty on a real install; never use a real password.
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
# Optional. The role of the demo account, shown under "Demo credentials" (for example: Hiring Manager).
NEXT_PUBLIC_DEMO_ROLE=
