{
  "name": "openats",
  "private": true,
  "version": "0.6.0",
  "description": "OpenATS monorepo root - orchestrates backend and frontend as a pnpm workspace",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "concurrently -n backend,worker,frontend -c blue,magenta,green \"pnpm --filter ./backend dev\" \"pnpm --filter ./backend dev:worker\" \"pnpm --filter ./frontend dev\"",
    "dev:backend": "pnpm --filter ./backend dev",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "build": "pnpm --filter ./backend build && pnpm --filter ./frontend build",
    "lint": "pnpm --filter ./backend lint && pnpm --filter ./frontend lint",
    "test": "pnpm --filter ./backend test:run && pnpm --filter ./frontend test:run",
    "test:watch": "pnpm --filter ./backend test",
    "test:e2e": "playwright test",
    "test:coverage": "pnpm --filter ./backend test:coverage",
    "test:frontend": "pnpm --filter ./frontend test:run"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
